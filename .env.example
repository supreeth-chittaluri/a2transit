# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Database -------------------------------------------------------------
# Local docker-compose default matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://a2transit:a2transit@localhost:5432/a2transit

# --- Redis (realtime pub/sub, M7) ----------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Application ----------------------------------------------------------
# One of: development, production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# --- Transit feeds --------------------------------------------------------
# Verified live 2026-09-03. See docs/feeds.md for provenance and licence terms.
THERIDE_GTFS_URL=https://www.theride.org/sites/default/files/google/google_transit.zip
THERIDE_GTFSRT_VEHICLES_URL=https://rt.theride.org/gtfsrt/vehicles
THERIDE_GTFSRT_TRIPS_URL=https://rt.theride.org/gtfsrt/trips
THERIDE_GTFSRT_ALERTS_URL=https://rt.theride.org/gtfsrt/alerts

MBUS_GTFS_URL=https://webapps.fo.umich.edu/transit_uploads/google_transit.zip
MBUS_GTFSRT_VEHICLES_URL=https://mbus.ltp.umich.edu/gtfsrt/vehicles
MBUS_GTFSRT_TRIPS_URL=https://mbus.ltp.umich.edu/gtfsrt/trips
MBUS_GTFSRT_ALERTS_URL=https://mbus.ltp.umich.edu/gtfsrt/alerts

# How often the realtime poller refetches each GTFS-RT feed, in seconds (M7).
REALTIME_POLL_SECONDS=20
